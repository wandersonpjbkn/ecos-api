{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "express-rate-limit": ["./src/vendor/expressRateLimit.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/*.mts", "src/**/*.mjs"],
  "exclude": ["dist", "node_modules"]
}
