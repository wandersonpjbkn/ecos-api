{
  "name": "ecos-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.mts -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --import ./dist/instrument.mjs ./dist/server.js",
    "lint": "eslint src tests --fix",
    "ts": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "audit:check": "yarn audit --summary; test $(( $? & 24 )) -eq 0",
    "migrate:csv": "tsx -r tsconfig-paths/register src/migrations/migrate-csv.ts",
    "migrate:categorias": "tsx -r tsconfig-paths/register src/migrations/migrate-categorias.ts",
    "migrate:autor": "tsx -r tsconfig-paths/register src/migrations/migrate-autor.ts",
    "migrate:midia": "tsx -r tsconfig-paths/register src/migrations/migrate-midia.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.75.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.0.1",
    "mongoose": "^8.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^15.12.0",
    "jiti": "^2.6.1",
    "supertest": "^7.3.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "typescript": "~5.7.2"
  }
}
