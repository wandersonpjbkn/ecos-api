# Porta do servidor (default: 3000)
API_PORT=3000

# Host para bind em desenvolvimento (opcional)
API_LOCALHOST=127.0.0.1

# Origins permitidas pelo CORS — separadas por vírgula
# OBRIGATÓRIO em produção.
# Exemplo: CORS_ORIGIN=https://<your.domain.com>
CORS_ORIGIN=
LOCAL_CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MongoDB Atlas connection string
# Exemplo: mongodb+srv://user:<your_password>@<your_cluster>.mongodb.net/<your_db>
MONGODB_URI=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEEPALIVE_EMAIL=
SUPABASE_KEEPALIVE_PASSWORD=

# Google Books API
GOOGLE_BOOKS_API_KEY=

# Open Library UserAgent
OPEN_LIBRARY_AGENT_LIB=
OPEN_LIBRARY_AGENT_USER=

# Sentry
SENTRY_DSN=